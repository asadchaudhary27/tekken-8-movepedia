# Tekken 8 FYP - Environment Configuration
APP_NAME="Tekken 8 Movepedia & Training Assistant"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
HOST="127.0.0.1"
PORT=8000

# Database Configuration (SQLite default with PostgreSQL migration compatibility)
DATABASE_URL="sqlite:///./tekken8_fyp.db"

# Data Fetching & Rate Limiting
REQUEST_TIMEOUT_SECONDS=15
MAX_RETRIES=3
RATE_LIMIT_DELAY_SECONDS=1.0

# CORS Origins (Comma-separated)
CORS_ORIGINS="http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000"
